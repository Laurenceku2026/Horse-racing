# Copy relevant keys into Streamlit Cloud → App settings → Secrets.
# Do NOT commit real passwords or app passwords into git.

# --- App public URL (password-reset email links) ---
APP_BASE_URL = "https://YOUR-APP.streamlit.app"

# --- Gmail SMTP (forgot-password emails) ---
# Use a Google Account App Password (2FA required), NOT the normal login password.
# Paste the 16-character app password only in Streamlit Secrets / local secrets.toml.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "YOUR_SMTP_USER@example.com"
SMTP_PASSWORD = "REPLACE_WITH_GMAIL_APP_PASSWORD"
SMTP_FROM = "YOUR_SMTP_USER@example.com"
SMTP_USE_TLS = "1"
